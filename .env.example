# ─────────────────────────────────────────────────────────────
# Example environment file. Copy to apps/web/.env.local and fill in real values.
# NEVER put real secrets in this file — it is committed to git.
# ─────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCTION_APP_URL=https://www.charitme.com
ADMIN_EMAILS=admin@example.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Management CLI token + project ref (migrations only; not read by the app runtime)
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_PROJECT_REF=your-project-ref

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_CONNECT_WEBHOOK_SECRET=your-stripe-connect-webhook-secret
DEFAULT_DONOR_TIP_PERCENT=8

# Cron
CRON_SECRET=your-cron-secret

# Email
RESEND_API_KEY=your-resend-api-key
SENDGRID_API_KEY=
EMAIL_FROM=CharitMe <hello@example.com>

# Google OAuth (configured in Supabase Auth → Providers)
GOOGLE_CLIENT_ID=google_client_id_placeholder
GOOGLE_CLIENT_SECRET=google_client_secret_placeholder
GOOGLE_CALLBACK_URL=https://your-project.supabase.co/auth/v1/callback

# OpenAI (blank ⇒ deterministic AI fallbacks)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# Unsplash (blank ⇒ campaign covers fall back to unique Lorem Picsum photos).
# The "Access Key" (Client-ID) from https://unsplash.com/oauth/applications.
# Used to assign category-themed, unique cover photos to campaigns.
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Optional SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Tests
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
