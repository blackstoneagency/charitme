# ─────────────────────────────────────────────
# Supabase — required for all auth and database queries
# ─────────────────────────────────────────────

# Public (baked into client bundle at build time — redeploy required after change)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only service role key — NEVER expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────
# Stripe — required for payments and billing
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Comma-separated list of admin emails (grants /admin access).
# blackstoneagencyllc@gmail.com is also hardcoded in lib/roles.ts as a fallback.
ADMIN_EMAILS=blackstoneagencyllc@gmail.com

# ─────────────────────────────────────────────
# Email (optional — for transactional emails)
# ─────────────────────────────────────────────
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@yourdomain.com
